{
  "name": "Simple Backtest Strategy",
  "description": "A minimal strategy for backtesting",
  "parameters": {
    "lookback_period": 14,
    "threshold": 0.5
  },
  "logic": [
    {
      "action": "buy",
      "condition": "if price crosses above moving_average"
    },
    {
      "action": "sell",
      "condition": "if price crosses below moving_average"
    }
  ]
}
